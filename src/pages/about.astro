---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  {
    num: '01',
    title: 'Problem Definition',
    desc: '从业务场景提炼真实问题与边界。例如：大量重复的 SDK 咨询与高人工成本 → 是否值得用 AI 客服承接，以及承接的边界在哪里。',
  },
  {
    num: '02',
    title: 'AI Solution Design',
    desc: '把问题转化为可落地的 AI 方案：Multi-Agent 分流、RAG 知识库治理、MCP 集成链路、Agent Prompt 任务规范。',
  },
  {
    num: '03',
    title: 'Evaluation',
    desc: '用历史 FAQ 构建测试用例（具体问题 / 模糊问题），持续测试、分析失败案例、迭代 Prompt，把「感觉好用」变成「可评估」。',
  },
  {
    num: '04',
    title: 'Delivery',
    desc: '在真实企业内部环境从 0 到 1 验证与交付，理解工程约束（版本、平台、编译链路），与研发、算法、业务多方协作。',
  },
];

const principles = [
  {
    num: '01',
    title: '先澄清，再检索',
    desc: '用户信息不足时，先问清 SDK 版本与开发平台，而不是让模型猜测——澄清比猜测更可靠。',
  },
  {
    num: '02',
    title: '先路由，再检索',
    desc: '用版本 / 平台分流划定知识边界，让每个 Agent 只面对对应知识，而不是让单一模型面对全部知识。',
  },
  {
    num: '03',
    title: '用 Evaluation 代替感觉',
    desc: '以历史 FAQ 构造测试用例，持续测试、分析失败、迭代 Prompt 并回归——把「感觉好用」变成「可评估」。',
  },
  {
    num: '04',
    title: '技术理解力服务产品判断',
    desc: '能读懂代码与工程约束，方案才不会停在 PPT——这也是我选择保留工程能力的原因。',
  },
];
---

<BaseLayout title="关于我 · AI Product Capability" description="懂研发的 AI 应用产品经理" current="about">
  <section class="hero" style="padding: 88px 0 56px;">
    <div class="container">
      <p class="kicker">About / AI Product Capability</p>
      <h1 class="h-xl" style="margin: 8px 0 20px;">懂研发的<br />AI 应用产品经理</h1>
      <p class="lead" style="max-width: 680px;">
        我是计算机科学与技术专业本科生，目标岗位是
        <strong>AI 应用产品经理 / AI Agent 产品经理 / AI 产品实习生</strong>。
        与纯产品背景的候选人不同，我的核心优势是：计算机基础 + 真实企业 AI
        应用落地经验。
      </p>
      <div class="hero-meta" style="margin-top: 28px;">
        <span class="tag tag--accent">目标岗位</span>
        <span class="tag">AI Application PM</span>
        <span class="tag">AI Agent PM</span>
        <span class="tag">AI Product Intern</span>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <p class="kicker">Why AI Product</p>
      <h2 class="h-lg" style="margin-bottom: 20px;">为什么是 AI 产品经理</h2>
      <p class="lead">
        我是计算机科学与技术本科生。在技术支持部门实习时，我看到 SDK 开发者
        的大量重复问题依赖人工查询文档、组织答案并回复——直到我参与了用 AI 客服
        承接这一流程的项目，完整走过了业务问题、方案设计、测试迭代的整个落地过程。
      </p>
      <p>
        真正让我兴奋的不是写代码本身，而是判断「AI 应该在哪个环节、以什么方式介入」，
        并且能用工程能力亲手验证方案可行。所以我选择 AI 应用产品方向：
        懂技术，更懂为什么这样设计。
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="kicker">Capability Model</p>
      <h2 class="h-lg" style="margin-bottom: 8px;">我的 AI 产品能力模型</h2>
      <div class="pillars" style="grid-template-columns: 1fr; gap: 0;">
        {
          capabilities.map((c) => (
            <div
              class="decision"
              style="display: grid; grid-template-columns: 72px 240px 1fr; gap: 24px; align-items: baseline; padding: 26px 0;"
            >
              <span class="work-item-index" style="font-family: var(--font-mono); font-size: 14px; color: var(--accent);">{c.num}</span>
              <h3 style="font-size: 17px;">{c.title}</h3>
              <p style="font-size: 14.5px; color: var(--text-3);">{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="kicker">Working Principles</p>
      <h2 class="h-lg" style="margin-bottom: 8px;">我的工作原则</h2>
      <p class="lead" style="max-width: 560px; margin-bottom: 8px;">
        从真实项目决策中沉淀下来的四条准则。
      </p>
      <div class="pillars" style="grid-template-columns: 1fr; gap: 0;">
        {
          principles.map((p) => (
            <div
              class="decision"
              style="display: grid; grid-template-columns: 72px 240px 1fr; gap: 24px; align-items: baseline; padding: 26px 0;"
            >
              <span class="work-item-index" style="font-family: var(--font-mono); font-size: 14px; color: var(--accent);">{p.num}</span>
              <h3 style="font-size: 17px;">{p.title}</h3>
              <p style="font-size: 14.5px; color: var(--text-3);">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <p class="kicker">Positioning</p>
      <h2 class="h-lg" style="margin-bottom: 20px;">一句话定位</h2>
      <p class="lead">
        懂研发、懂 AI 技术，同时具备 AI 应用产品设计和落地能力——我能把大模型
        能力翻译成用户可感知的价值，也能亲手用 Python / Java 验证方案是否可行。
      </p>

      <h3 class="h-md" style="margin: 40px 0 14px;">核心关键词</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px;">
        {
          ['AI Application', 'Agent', 'RAG', 'Multi-Agent', 'MCP', 'Prompt Engineering', 'AI Evaluation', 'Workflow Automation'].map(
            (t) => <span class="tag tag--accent">{t}</span>,
          )
        }
      </div>

      <h3 class="h-md" style="margin-bottom: 14px;">工程能力（辅助）</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {
          ['Java', 'Python', 'SQL', 'SpringBoot', 'MySQL', 'Redis', 'WebSocket'].map(
            (t) => <span class="tag">{t}</span>,
          )
        }
      </div>
    </div>
  </section>

  <section class="section" style="border-top: 1px solid var(--line);">
    <div class="container prose" style="text-align: center;">
      <p class="kicker">Contact</p>
      <h2 class="h-lg" style="margin-bottom: 16px;">开放交流</h2>
      <p class="lead" style="max-width: 520px; margin: 0 auto 28px;">
        如果你在找懂 AI 技术、能落地验证的 AI 产品经理，或想聊聊 AI 应用产品，欢迎联系我。
      </p>
      <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a class="btn btn--solid" href="mailto:youremail@example.com">Email Me</a>
        <a class="btn btn--outline" href="https://github.com/yourname" target="_blank" rel="noopener">GitHub</a>
      </div>
      <p class="small muted" style="margin-top: 20px;">
        邮箱与 GitHub 为占位，记得替换成你的真实信息。
      </p>
    </div>
  </section>
</BaseLayout>

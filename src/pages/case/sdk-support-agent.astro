---
import CaseStudyLayout, { type CaseSection } from '../../layouts/CaseStudyLayout.astro';

const sections: CaseSection[] = [
  {
    id: 's01',
    num: '01',
    title: 'Problem',
    blocks: [
      {
        type: 'info',
        rows: [
          ['Role', 'AI Application / Product Intern'],
          ['Context', 'Developer Technical Support'],
          ['Status', 'Internal Testing'],
          ['Stack', 'Dify · RAGFlow · Multi-Agent · RAG · Prompt Engineering · Python'],
        ],
      },
      {
        type: 'p',
        text: '将依赖人工回复的 SDK 技术支持流程，转化为基于 SDK 版本、开发平台和知识库路由的 AI 问答流程。',
      },
      { type: 'h', text: '传统流程' },
      {
        type: 'flow',
        lines: [
          '开发者提出 SDK 技术问题',
          '↓ 技术支持人员判断 SDK 版本',
          '↓ 判断开发平台',
          '↓ 查询对应开发文档 / FAQ',
          '↓ 人工组织答案',
          '↓ 回复开发者',
        ],
      },
      { type: 'h', text: '核心问题' },
      {
        type: 'list',
        items: [
          '技术问题回复依赖人工，重复咨询消耗大量支持成本。',
          'SDK 存在多个大版本：TopOn / Taku / 酷盈，需要分别维护。',
          '每个版本又包含 Android / iOS / Unity / Flutter / Cocos / Harmony 等多个平台。',
          '文档规模较大，三个版本累计包含数百个 Markdown 文档。',
          '不同平台之间的 SDK 接入方式存在差异，跨平台检索可能导致错误回答。',
        ],
      },
    ],
  },
  {
    id: 's02',
    num: '02',
    title: 'Product Decision',
    blocks: [
      { type: 'h', text: '先路由，再检索' },
      {
        type: 'p',
        text: '如果使用单一 Agent + 全量知识库，模型需要同时判断 SDK 版本和开发平台，容易检索到不相关文档。因此设计 Multi-Agent 分流：',
      },
      {
        type: 'flow',
        lines: [
          '用户',
          '→ SDK Version',
          '→ 对应 Version Agent',
          '→ Developer Platform',
          '→ Platform-specific Knowledge Base',
          '→ RAG Retrieval',
          '→ LLM Answer',
        ],
      },
      {
        type: 'note',
        bold: '产品决策',
        text: '根据 SDK 版本进行初步分流，并通过平台上下文进一步限制知识检索范围。',
      },
    ],
  },
  {
    id: 's03',
    num: '03',
    title: 'Platform-aware Retrieval',
    blocks: [
      {
        type: 'flow',
        lines: [
          '用户问题',
          '↓ 是否已说明开发平台？',
          '├─ 已说明 → 直接检索对应平台知识',
          '└─ 未说明 → 先询问 Android / iOS / Unity / Flutter / Cocos / Harmony 等平台',
          '↓ 只检索对应平台文档',
          '↓ 生成回答',
        ],
      },
      { type: 'h', text: '实现方式' },
      {
        type: 'list',
        items: [
          '对文档增加 Android / iOS / Unity 等平台前缀',
          '在 Agent System Prompt 中增加平台约束',
          '明确要求根据用户平台检索对应文档',
          '禁止使用其他平台文档作为回答依据',
          '如果用户已经提供平台，不重复询问',
          '如果平台不明确，先澄清再检索',
        ],
      },
      {
        type: 'note',
        bold: '说明',
        text: '通过 Agent 路由、文档命名和 Prompt 约束实现平台级检索边界（并非严格意义上的物理知识库隔离）。',
      },
    ],
  },
  {
    id: 's04',
    num: '04',
    title: 'Knowledge Base Governance',
    blocks: [
      {
        type: 'flow',
        lines: [
          '600+ FAQ',
          '↓ 清洗 / 治理 / 去重 / 规范化',
          '↓',
          '100+ 可用于知识库的 FAQ',
        ],
      },
      {
        type: 'p',
        text: '参与 600+ 条历史 FAQ 的清洗与治理，整理为 100+ 条可用于知识库的 FAQ。',
      },
      { type: 'h', text: '文档关联问题' },
      {
        type: 'p',
        text: '发现 SDK 文档之间存在大量超链接关联，但模型检索过程中无法充分利用这些关系。',
      },
      {
        type: 'p',
        text: '使用 Python 构建文档关联知识图谱，将存在关联关系的文档进行连接，增强相关文档之间的可发现性。',
      },
      {
        type: 'note',
        bold: '职责边界',
        text: '不负责 Chunking、Embedding、Reranker、Vector DB 等检索底层细节。',
      },
    ],
  },
  {
    id: 's05',
    num: '05',
    title: 'AI Evaluation',
    blocks: [
      { type: 'h', text: '测试集' },
      {
        type: 'p',
        text: '基于历史 FAQ 设计 AI 问答测试用例：',
      },
      {
        type: 'list',
        items: [
          '具体问题',
          '模糊问题',
          '不同 SDK 版本',
          '不同开发平台',
          '跨平台干扰场景',
        ],
      },
      { type: 'h', text: 'Evaluation Loop' },
      {
        type: 'flow',
        lines: [
          '测试',
          '→ 问题分析',
          '→ Prompt 优化',
          '→ 回归测试',
          '→ 再次评估',
        ],
      },
      {
        type: 'p',
        text: '基于历史 FAQ 设计 AI 问答测试用例，通过测试结果分析问题并持续迭代 Prompt 与知识库。',
      },
    ],
  },
  {
    id: 's06',
    num: '06',
    title: 'Retrieval Experiment',
    blocks: [
      {
        type: 'note',
        bold: '小型实验',
        text: '在内部测试过程中对检索参数进行调整，将 Top-K 从 0.4 调整至 0.8 后，内部测试中的错误回答有所减少。',
      },
      {
        type: 'note',
        bold: '说明',
        text: '该调整基于内部测试观察，非正式 A/B Test，不虚构准确率提升百分比。',
      },
    ],
  },
  {
    id: 's07',
    num: '07',
    title: 'Result',
    blocks: [
      {
        type: 'p',
        text: '完成内部测试，验证 SDK 版本/平台分流、知识库检索及 AI 问答流程，并通过测试用例持续进行 Prompt 与知识库迭代。',
      },
      {
        type: 'note',
        bold: 'Status',
        text: 'Internal Testing。未对外正式上线，不虚构业务指标与上线数据。',
      },
    ],
  },
  {
    id: 's08',
    num: '08',
    title: 'Reflection',
    blocks: [
      {
        type: 'p',
        text: 'AI 应用落地并非简单接入 LLM，而是需要围绕知识边界、用户上下文、检索范围和 Evaluation 建立完整闭环。',
      },
    ],
  },
];
---

<CaseStudyLayout
  caseNo="01"
  title="SDK Developer AI Support Agent"
  subtitle="面向 SDK 开发者的 AI 技术支持助手"
  description="SDK Developer AI Support Agent Case Study"
  tags={['Dify', 'RAGFlow', 'Multi-Agent', 'RAG', 'Prompt Engineering', 'Python']}
  sections={sections}
  neighbors={{
    next: { href: '/case/mcp-integration-agent', label: 'Case 02 · MCP SDK Integration Agent' },
  }}
/>

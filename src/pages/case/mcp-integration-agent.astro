---
import CaseStudyLayout, { type CaseSection } from '../../layouts/CaseStudyLayout.astro';

const sections: CaseSection[] = [
  {
    id: 's01',
    num: '01',
    title: 'Overview',
    blocks: [
      {
        type: 'info',
        rows: [
          ['Role', 'AI Application / Product Intern'],
          ['Status', '方案验证'],
          ['Stack', 'MCP · Agent · Prompt Engineering · SDK Integration'],
        ],
      },
      {
        type: 'p',
        text: '参与验证基于 IDE Agent + Remote MCP + Local CLI 的 SDK 自动化集成方案，将自然语言需求转化为可执行的 SDK 接入流程。',
      },
      {
        type: 'tags',
        accent: true,
        items: ['MCP', 'Agent', 'Prompt Engineering', 'SDK Integration'],
      },
    ],
  },
  {
    id: 's02',
    num: '02',
    title: '我的职责',
    blocks: [
      {
        type: 'p',
        text: '在本项目中，我负责方案验证环节中与 Agent 行为直接相关的部分：',
      },
      {
        type: 'list',
        items: [
          '负责 Agent Prompt 的设计与迭代',
          '在 Android Demo 中验证不同 Prompt 对 SDK 自动集成效果的影响',
          '针对代码遗漏、配置错误及编译问题进行迭代优化',
          '协助验证完整 Agent Workflow',
        ],
      },
      {
        type: 'note',
        bold: '职责边界',
        text: '不独立开发整个 MCP 系统，Remote MCP / Local CLI 为团队已有能力，我的工作聚焦于 Agent Prompt 设计与端到端方案验证。',
      },
    ],
  },
  {
    id: 's03',
    num: '03',
    title: 'Architecture',
    blocks: [
      {
        type: 'p',
        text: '整体方案将 SDK 接入过程 Agent 化，由 IDE Agent 理解自然语言需求，通过 Remote MCP 生成并确认接入计划，由 Local CLI 执行分析与注入。',
      },
      {
        type: 'flow',
        lines: [
          'IDE Agent',
          '↓',
          'Remote MCP',
          '↓',
          'Local CLI',
          '↓',
          'Developer Android / iOS Project',
        ],
      },
      { type: 'h', text: 'Remote MCP' },
      {
        type: 'list',
        items: [
          'build_plan —— 生成 SDK 接入计划',
          'confirm_plan —— 供用户确认接入方案',
          'consume_approval —— 消费用户批准',
          'get_vocabulary —— 获取 SDK 接入词汇/规范',
        ],
      },
      { type: 'h', text: 'Local CLI' },
      {
        type: 'list',
        items: [
          'analyze —— 扫描并分析项目工程',
          'inject —— 注入 SDK 相关代码',
          'verify —— 校验注入结果',
        ],
      },
    ],
  },
  {
    id: 's04',
    num: '04',
    title: 'Agent Workflow',
    blocks: [
      {
        type: 'flow',
        lines: [
          '能力预检',
          '→ 信息收集',
          '→ 项目扫描',
          '→ 生成接入方案',
          '→ 用户确认',
          '→ SDK 代码注入',
          '→ 反向校验',
          '→ 编译验证',
          '→ 总结',
        ],
      },
      {
        type: 'note',
        bold: '核心链路',
        text: '自然语言需求 → Agent Plan → 用户确认 → SDK 注入 → 校验 → 编译验证',
      },
    ],
  },
  {
    id: 's05',
    num: '05',
    title: 'Prompt Design & Iteration',
    blocks: [
      {
        type: 'p',
        text: 'Prompt 是决定 Agent 能否稳定完成 SDK 注入的关键。我在 Android Demo 中反复验证不同 Prompt 结构对自动集成效果的影响：',
      },
      {
        type: 'list',
        items: [
          '任务目标与代码修改范围',
          'SDK 接入所需的认证信息与配置',
          '需要实现的功能与生命周期要求',
          '代码遗漏与配置错误的防范约束',
          '最终编译验证的强制要求',
        ],
      },
      {
        type: 'note',
        bold: '迭代方式',
        text: '以「注入 Demo → 编译验证」为验收标准，针对代码遗漏、配置错误及编译问题分析失败原因，再调整 Prompt 结构进行回归验证。',
      },
    ],
  },
  {
    id: 's06',
    num: '06',
    title: 'Result',
    blocks: [
      {
        type: 'p',
        text: '完成 Android Demo SDK 自动化注入及编译验证。',
      },
      {
        type: 'note',
        bold: 'Status',
        text: '方案验证。该方案处于验证阶段，未对外正式上线，不虚构业务指标。',
      },
    ],
  },
  {
    id: 's07',
    num: '07',
    title: 'Reflection',
    blocks: [
      {
        type: 'p',
        text: '把自然语言需求转化为 Agent 可执行的任务规范，是 AI Agent 类产品最关键的翻译层工作。清晰的 Prompt 与可验证的闭环（注入 → 校验 → 编译验证），比单纯依赖模型能力更能决定结果的稳定性。',
      },
    ],
  },
];
---

<CaseStudyLayout
  caseNo="02"
  title="MCP SDK Integration Agent"
  subtitle="让自然语言需求驱动 SDK 自动集成"
  description="MCP SDK Integration Agent Case Study"
  tags={['MCP', 'Agent', 'Prompt Engineering', 'SDK Integration']}
  sections={sections}
  neighbors={{
    prev: { href: '/case/sdk-support-agent', label: 'Case 01 · SDK Developer AI Support Agent' },
  }}
/>

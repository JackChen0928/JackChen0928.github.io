---
import CaseStudyLayout, { type CaseSection } from '../../layouts/CaseStudyLayout.astro';

const sections: CaseSection[] = [
  {
    id: 's01',
    num: '01',
    title: 'Overview',
    blocks: [
      {
        type: 'p',
        text: '用 MCP 把 SDK 接入过程 Agent 化：参与 Remote MCP + Local CLI + IDE Agent 方案验证，重点负责 Agent Prompt 的设计与迭代，研究「如何把自然语言需求转化为 Agent 可执行任务规范」。',
      },
      {
        type: 'info',
        rows: [
          ['角色', 'AI 产品实习（参与方案验证）'],
          ['状态', '方案验证'],
          ['工具', 'MCP · IDE Agent · Local CLI · Gradle / xcodebuild'],
          ['支持范围', 'HyperBid / TopOn · Android / iOS'],
        ],
      },
      { type: 'tags', accent: true, items: ['MCP', 'Agent', 'Prompt Engineering', 'SDK'] },
    ],
  },
  {
    id: 's02',
    num: '02',
    title: 'Background',
    blocks: [
      {
        type: 'p',
        text: '传统 SDK 接入流程需要开发者：查看 SDK 文档、配置依赖、初始化 SDK、调用广告 API、编译验证。步骤多、易出错，对不熟悉广告 SDK 的开发者门槛尤其高。',
      },
      {
        type: 'p',
        text: '团队为此设计了一套 Remote MCP + Local CLI + IDE Agent 架构，目标是让开发者用自然语言即可完成 SDK 集成。',
      },
    ],
  },
  {
    id: 's03',
    num: '03',
    title: 'Problem',
    blocks: [
      {
        type: 'p',
        text: '如何把一段自然语言需求（例如「帮我集成 TopOn SDK 并展示广告」）转化为 Agent 可以一步步执行的任务，并最终保证工程可编译、可运行。',
      },
    ],
  },
  {
    id: 's04',
    num: '04',
    title: 'User',
    blocks: [
      {
        type: 'p',
        text: '需要集成 HyperBid / TopOn 广告 SDK 的移动开发者（Android / iOS）。',
      },
    ],
  },
  {
    id: 's05',
    num: '05',
    title: 'Goal',
    blocks: [
      {
        type: 'p',
        text: '让 Agent 尽可能一次完成 SDK 注入，并确保注入后项目可以编译运行，减少开发者手动操作。量化指标待补充。',
      },
    ],
  },
  {
    id: 's06',
    num: '06',
    title: 'Product Solution',
    blocks: [
      {
        type: 'p',
        text: '开发者在 IDE Agent 内用自然语言描述需求，Agent 与 Remote MCP 协作生成接入计划，经确认后调用 Local CLI 完成分析、注入与编译验证。',
      },
      {
        type: 'flow',
        lines: [
          'IDE Agent',
          '↓',
          'Remote MCP',
          '↓ build_plan / confirm_plan',
          '↓',
          'Local CLI（analyze → inject → verify）',
          '↓',
          'Gradle / xcodebuild',
          '↓',
          '完成 SDK 集成（可编译可运行）',
        ],
      },
    ],
  },
  {
    id: 's07',
    num: '07',
    title: 'AI Architecture',
    blocks: [
      {
        type: 'p',
        text: '核心是 Agent Prompt 的任务规范设计——把自然语言需求翻译成明确、可执行、可验证的任务。Prompt 中明确以下内容：',
      },
      {
        type: 'list',
        items: [
          '任务目标',
          'SDK 认证信息',
          '需要实现的功能',
          '代码修改范围',
          '生命周期要求',
          '异常处理',
          '内存泄漏防护',
          '最终编译验证要求',
        ],
      },
      {
        type: 'note',
        bold: '职责边界',
        text: '不独立设计 MCP 架构、不独立开发 Local CLI、不负责整个 Agent Workflow。本人负责方案验证、使用 MCP 将 SDK 注入 Demo，以及 Agent Prompt 的设计与迭代。',
      },
    ],
  },
  {
    id: 's08',
    num: '08',
    title: 'Key Product Decisions',
    blocks: [
      {
        type: 'decisions',
        itemsDecisions: [
          {
            label: 'D1',
            title: '明确任务边界',
            text: '在 Prompt 中界定代码修改范围与生命周期要求，约束 Agent 行为，减少破坏性改动。',
          },
          {
            label: 'D2',
            title: '强制最终验证',
            text: 'Prompt 末尾固定编译验证要求（Gradle / xcodebuild），保证交付物可编译运行。',
          },
          {
            label: 'D3',
            title: '一次完成优先',
            text: '持续调优 Prompt 结构，研究如何让 Agent 尽量一次完成注入，减少多轮交互。',
          },
          {
            label: 'D4',
            title: '认证信息前置',
            text: 'SDK 认证信息在 Prompt 中明确给出，避免 Agent 猜测与反复试探。',
          },
        ],
      },
    ],
  },
  {
    id: 's09',
    num: '09',
    title: 'Evaluation',
    blocks: [
      {
        type: 'p',
        text: '以「Agent 注入 Demo → 编译验证」作为可执行验收标准；通过反复试验记录 Agent 一次成功率与失败原因，据此迭代 Prompt。',
      },
    ],
  },
  {
    id: 's10',
    num: '10',
    title: 'Iteration',
    blocks: [
      {
        type: 'p',
        text: '以「失败原因分析 → Prompt 结构调整 → 再注入验证」为闭环持续迭代，逐步提高一次注入成功率。',
      },
    ],
  },
  {
    id: 's11',
    num: '11',
    title: 'Result',
    blocks: [
      {
        type: 'p',
        text: '完成方案验证：使用 MCP 成功将 SDK 注入 Demo，接入链路可编译、可运行。规模化数据待补充。',
      },
    ],
  },
  {
    id: 's12',
    num: '12',
    title: 'Reflection',
    blocks: [
      {
        type: 'p',
        text: '核心收获：把自然语言需求转化为 Agent 可执行任务规范，是 AI Agent 类产品最关键的翻译层工作；清晰的任务规范比模型能力更能决定结果稳定性。',
      },
    ],
  },
];
---

<CaseStudyLayout
  caseNo="02"
  title="MCP SDK Integration Agent"
  subtitle="把自然语言需求，转化为 Agent 可执行的任务规范。"
  description="MCP SDK Integration Agent Case Study"
  tags={['MCP', 'Agent', 'Prompt Engineering', 'SDK']}
  sections={sections}
  neighbors={{
    prev: { href: '/case/sdk-support-agent', label: 'Case 01' },
    next: { href: '/case/package-size-automation', label: 'Case 03' },
  }}
/>

    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-4);
  }
  .sdkai-project-switch a {
    font-size: 14px;
    font-weight: 600;
  }

  /* ==================== 在线体验 ==================== */
  .sdkai-demo {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 24px;
    align-items: start;
    margin-top: 20px;
  }
  .sdkai-side {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
  }
  .sdkai-side-block {
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }
  .sdkai-side-block:last-child { border-bottom: 0; }
  .sdkai-side-block h4 {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-3);
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }
  .sdkai-field {
    display: block;
    margin-bottom: 12px;
  }
  .sdkai-field:last-child { margin-bottom: 0; }
  .sdkai-field > span {
    display: block;
    font-size: 12.5px;
    color: var(--text-3);
    margin-bottom: 6px;
  }
  .sdkai-field select,
  .sdkai-field input {
    width: 100%;
    padding: 9px 12px;
    font-size: 14px;
    font-family: var(--font-sans);
    color: var(--text);
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .sdkai-field select:focus,
  .sdkai-field input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }
  .sdkai-quick {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sdkai-quick-btn {
    text-align: left;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--text-2);
    background: #fafafa;
    border: 1px solid var(--line);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s;
  }
  .sdkai-quick-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .sdkai-quick-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sdkai-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .sdkai-actions .btn { flex: 1; justify-content: center; }

  /* 聊天主区 */
  .sdkai-chat {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 560px;
  }
  .sdkai-chat-status {
    padding: 10px 16px;
    font-size: 12px;
    color: var(--text-3);
    background: var(--accent-soft);
    border-bottom: 1px solid var(--line);
  }
  .sdkai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 380px;
    max-height: 520px;
  }
  .sdkai-msg { display: flex; flex-direction: column; max-width: 88%; }
  .sdkai-msg--user { align-self: flex-end; align-items: flex-end; }
  .sdkai-msg--assistant { align-self: flex-start; align-items: flex-start; }
  .sdkai-msg--system {
    align-self: center;
    max-width: 96%;
    font-size: 12.5px;
    color: var(--text-3);
    background: #f3f4f6;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    text-align: center;
  }
  .sdkai-msg-label {
    font-size: 11px;
    color: var(--text-4);
    margin-bottom: 4px;
  }
  .sdkai-bubble {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .sdkai-msg--user .sdkai-bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 3px;
  }
  .sdkai-msg--assistant .sdkai-bubble {
    background: #fafafa;
    border: 1px solid var(--line);
    border-bottom-left-radius: 3px;
    color: var(--text);
  }
  .sdkai-msg--assistant .sdkai-bubble--warn {
    background: #fffbeb;
    border-color: #fcd34d;
    color: #92400e;
  }
  .sdkai-step {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 0;
    font-size: 13px;
    color: var(--text-2);
  }
  .sdkai-step-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
    animation: sdkai-pulse 1.4s ease-in-out infinite;
  }
  @keyframes sdkai-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }
  .sdkai-clarify-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .sdkai-btn--chip {
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.18s;
  }
  .sdkai-btn--chip:hover {
    background: var(--accent);
    color: #fff;
  }
  .sdkai-btn--chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sdkai-sources {
    margin-top: 10px;
    width: 100%;
  }
  .sdkai-sources-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-3);
    margin-bottom: 8px;
  }
  .sdkai-source {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    margin-bottom: 8px;
    overflow: hidden;
  }
  .sdkai-source summary {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 10px 12px;
    cursor: pointer;
    list-style: none;
  }
  .sdkai-source summary::-webkit-details-marker { display: none; }
  .sdkai-source summary::before {
    content: "▸";
    color: var(--accent);
    transition: transform 0.18s;
  }
  .sdkai-source[open] summary::before { transform: rotate(90deg); }
  .sdkai-source-title {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    flex: 1 1 auto;
  }
  .sdkai-source-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
  }
  .sdkai-demo-tag {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 600;
    color: #92400e;
    background: #fffbeb;
    border: 1px solid #fcd34d;
    border-radius: 999px;
    padding: 1px 8px;
  }
  .sdkai-source-body {
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-2);
  }
  .sdkai-source-label {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
  }
  .sdkai-feedback {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .sdkai-fb {
    font-size: 12px;
    color: var(--text-3);
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 3px 12px;
    cursor: pointer;
    transition: all 0.18s;
  }
  .sdkai-fb:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .sdkai-fb:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sdkai-fb-note {
    font-size: 12px;
    color: var(--accent);
  }

  /* 输入区 */
  .sdkai-composer {
    border-top: 1px solid var(--line);
    padding: 12px 14px;
    background: #fff;
  }
  .sdkai-composer textarea {
    width: 100%;
    resize: none;
    padding: 10px 12px;
    font-size: 14px;
    font-family: var(--font-sans);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    line-height: 1.6;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .sdkai-composer textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }
  .sdkai-composer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }
  .sdkai-composer-hint {
    font-size: 12px;
    color: var(--text-4);
  }
  .sdkai-composer .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ==================== 工作流设计 ==================== */
  .sdkai-wf-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 28px;
    align-items: start;
    margin-top: 20px;
  }
  .sdkai-wf-flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 22px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
  }
  .sdkai-wf-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 176px;
    padding: 10px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    transition: all 0.18s;
    text-align: center;
  }
  .sdkai-wf-node:hover {
    border-color: var(--accent);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
  }
  .sdkai-wf-node:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sdkai-wf-node-id {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    color: var(--text-4);
    letter-spacing: 0.06em;
  }
  .sdkai-wf-node.is-done {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }
  .sdkai-wf-node.is-active {
    border-color: var(--accent-strong);
    background: var(--accent-strong);
    color: #fff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18);
  }
  .sdkai-wf-node.is-active .sdkai-wf-node-id { color: rgba(255, 255, 255, 0.8); }
  .sdkai-wf-node.is-branch {
    border-color: #d97706;
    background: #fffbeb;
    color: #92400e;
  }
  .sdkai-wf-node.sdkai-wf-node--danger.is-branch {
    border-color: #dc2626;
    background: #fef2f2;
    color: #b91c1c;
  }
  .sdkai-wf-conn {
    position: relative;
    width: 2px;
    height: 22px;
    background: var(--line-strong);
    margin: 2px 0;
  }
  .sdkai-wf-conn--down::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -1px;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--line-strong);
  }
  .sdkai-wf-conn--merge { height: 24px; }
  .sdkai-wf-conn--merge .sdkai-wf-chip {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
  }
  .sdkai-wf-branch {
    display: flex;
    align-items: center;
    width: 100%;
    padding-left: 12px;
  }
  .sdkai-wf-branch-line {
    position: relative;
    flex: 1;
    min-width: 72px;
    height: 2px;
    background: var(--line-strong);
  }
  .sdkai-wf-branch-line::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -5px;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-bottom-color: var(--line-strong);
  }
  .sdkai-wf-branch-line .sdkai-wf-chip {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .sdkai-wf-chip {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-3);
    background: var(--bg);
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .sdkai-wf-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .sdkai-wf-block {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 18px 20px;
  }
  .sdkai-wf-block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sdkai-wf-block h4 {
    font-size: 14px;
    font-weight: 700;
  }
  .sdkai-btn-sm {
    padding: 6px 14px;
    font-size: 13px;
  }
  .sdkai-wf-hint {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--text-4);
  }
  .sdkai-wf-table-wrap {
    margin-top: 12px;
    overflow-x: auto;
  }
  .sdkai-wf-vars {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .sdkai-wf-vars td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .sdkai-wf-vars tr:last-child td { border-bottom: 0; }
  .sdkai-var-key {
    width: 46%;
    font-weight: 600;
    color: var(--text-2);
    white-space: nowrap;
  }
  .sdkai-var-value {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text);
    word-break: break-all;
  }
  .sdkai-wf-detail {
    margin-top: 12px;
  }
  .sdkai-wf-detail-empty {
    font-size: 13px;
    color: var(--text-3);
    background: #fafafa;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    padding: 14px;
  }
  .sdkai-wf-detail-head {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .sdkai-wf-detail-grid {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 8px 12px;
    font-size: 13px;
  }
  .sdkai-wf-detail-grid dt {
    color: var(--text-3);
    font-weight: 600;
  }
  .sdkai-wf-detail-grid dd {
    color: var(--text-2);
    word-break: break-word;
  }

  /* ==================== 知识库 ==================== */
  .sdkai-kb-filters {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .sdkai-kb-count {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
  }
  .sdkai-kb-list {
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .sdkai-kb-card {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 16px 18px;
  }
  .sdkai-kb-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .sdkai-kb-card-head h4 {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text);
  }
  .sdkai-kb-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .sdkai-kb-meta span {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    background: #f3f4f6;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .sdkai-kb-content {
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.7;
  }
  .sdkai-kb-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .sdkai-tag {
    font-size: 11px;
    color: var(--text-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .sdkai-kb-source {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
  }
  .sdkai-kb-related-box {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  .sdkai-kb-related-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-3);
    display: block;
    margin-bottom: 6px;
  }
  .sdkai-kb-related {
    display: block;
    width: 100%;
    text-align: left;
    font-size: 12.5px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 10px;
    margin-bottom: 6px;
    cursor: pointer;
    transition: all 0.18s;
  }
  .sdkai-kb-related:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }
  .sdkai-kb-related:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sdkai-empty {
    grid-column: 1 / -1;
    padding: 32px;
    text-align: center;
    color: var(--text-3);
    background: #fafafa;
    border: 1px dashed var(--line-strong);
    border-radius: 10px;
    font-size: 14px;
  }

  /* ==================== 知识图谱概念图 ==================== */
  .sdkai-graph {
    margin-top: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    padding: 18px 16px 14px;
    max-width: 800px;
  }
  .sdkai-graph svg { display: block; width: 100%; height: auto; }
  .sdkai-graph-edge {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .sdkai-graph-edge--cross {
    stroke: #d97706;
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }
  .sdkai-graph-node rect {
    fill: #fff;
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .sdkai-graph-node--faq rect {
    fill: #f0fdf4;
    stroke: #16a34a;
  }
  .sdkai-graph-title {
    font-size: 11.5px;
    font-weight: 600;
    fill: var(--text);
    text-anchor: middle;
  }
  .sdkai-graph-meta {
    font-size: 10px;
    fill: var(--text-3);
    text-anchor: middle;
  }
  .sdkai-graph-label rect { fill: #f3f4f6; stroke: none; }
  .sdkai-graph-label text {
    font-size: 10px;
    font-weight: 600;
    fill: var(--text-3);
    text-anchor: middle;
  }
  .sdkai-graph-label--warn rect { fill: #fffbeb; }
  .sdkai-graph-label--warn text { fill: #92400e; }
  .sdkai-graph-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--line);
    font-size: 12px;
    color: var(--text-3);
  }
  .sdkai-graph-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .sdkai-graph-swatch { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
  .sdkai-graph-swatch--doc { background: var(--accent); }
  .sdkai-graph-swatch--faq { background: #16a34a; }
  .sdkai-graph-swatch--link { background: var(--line-strong); height: 2px; border-radius: 0; }
  .sdkai-graph-swatch--cross { background: transparent; border-top: 2px dashed #d97706; height: 2px; border-radius: 0; }

  /* ==================== Prompt 与评测 ==================== */
  .sdkai-prompt {
    margin-top: 6px;
    padding: 18px 20px;
    background: #0b1220;
    color: #dbeafe;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.8;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
  }
  .sdkai-eval-summary {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
  }
  .sdkai-table-wrap {
    margin-top: 12px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .sdkai-eval-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    min-width: 1440px;
  }
  .sdkai-eval-table th,
  .sdkai-eval-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .sdkai-eval-table thead th {
    background: #fafafa;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-3);
    position: sticky;
    top: 0;
  }
  .sdkai-eval-table tbody tr:last-child td { border-bottom: 0; }
  .sdkai-eval-table tbody tr:hover td { background: #fafafa; }
  .sdkai-eval-id {
    font-family: var(--font-mono);
    font-size: 12px;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  SDK_VERSIONS,
  PLATFORMS,
  DOC_TYPES,
} from '../../data/sdk-support-demo';

const promptSnippet = `【回答依据与范围】
1. 仅在已确认的 SDK 版本与开发平台范围内回答，不得跨版本、跨平台混用。
2. 未选择版本或未指定平台时，先追问，不猜测作答。

【事实约束】
3. 资料不足时明确说明缺少依据，不编造技术结论；不编造 SDK 参数、接口和代码。
4. 回答尽量附来源：文档标题、SDK 版本、开发平台、文档类型。`;

/** Prompt 设计意图：每条约束对应的具体风险 */
const promptIntents: Array<{ rule: string; risk: string }> = [
  {
    rule: '仅在已确认的 SDK 版本与开发平台范围内回答',
    risk: '不同版本文档和使用方式不同，跨版本混用会导致过时或不兼容的答案。',
  },
  {
    rule: '不将一个平台的接入方式套用到另一个平台',
    risk: 'Android / iOS / Unity 接入方式差异大，套用其他平台步骤会直接导致接入失败。',
  },
  {
    rule: '问题与所选平台不一致时先确认平台',
    risk: '不确认就回答，容易按错误平台生成技术结论，用户照着做才发现不对。',
  },
  {
    rule: '信息缺失时先补充提问',
    risk: '缺少版本、平台或报错上下文时强行作答，答非所问，延长排查链路。',
  },
  {
    rule: '资料不足时明确说明，不编造结论',
    risk: '无依据编造会产生幻觉答案，误导用户排查方向，且难以被察觉。',
  },
  {
    rule: '不编造 SDK 参数、接口和代码',
    risk: '虚构的接口名、参数或代码片段无法编译通过，损害可信度。',
  },
  {
    rule: '回答附来源与资料范围',
    risk: '没有来源时用户无法核对与深入阅读，也难以判断答案是否对应当前版本。',
  },
];

/** 用户问题与需求拆解（作品集方案分析） */
const problems: Array<{ issue: string; need: string; tag: string }> = [
  {
    issue: 'SDK 使用问题存在重复咨询，支持人员反复回答类似问题。',
    need: '把高频问题整理为可复用的 FAQ，作为助手自动回答的检索来源。',
    tag: '真实背景',
  },
  {
    issue: 'SDK 版本不同，文档和使用方式可能不同。',
    need: '先确认 SDK 版本，再按版本路由限定检索范围。',
    tag: '真实背景',
  },
  {
    issue: 'Android、iOS、Unity 等平台的接入方式存在差异。',
    need: '判断开发平台，按平台路由与过滤检索结果。',
    tag: '真实背景',
  },
  {
    issue: '文档之间的超链接关系可能影响相关内容被发现。',
    need: '关联相关文档，顺着引用关系找到配套资料。',
    tag: '真实背景',
  },
];
---

<BaseLayout
  title="SDK 开发者智能问答与知识库系统"
  description="围绕 SDK 版本与开发平台差异，探索基于 RAG 的开发者技术支持方案：Dify 工作流迭代、RAGFlow 知识库治理、文档关联知识图谱与问答评测"
  current="work"
>
  <!-- ======================= 页头 ======================= -->
  <section class="sdkai-hero">
    <div class="container">
      <p class="kicker">Internal POC · Work</p>
      <h1 class="sdkai-title">SDK 开发者智能问答与知识库系统</h1>
      <p class="sdkai-subtitle">围绕 SDK 版本与开发平台差异，探索基于 RAG 的开发者技术支持方案。</p>
      <div class="sdkai-hero-meta">
        <div class="sdkai-hero-meta-item">
          <span class="sdkai-hero-meta-key">项目类型</span>
          <span class="sdkai-hero-meta-val">内部 POC</span>
        </div>
        <div class="sdkai-hero-meta-item">
          <span class="sdkai-hero-meta-key">核心技术</span>
          <span class="sdkai-hero-meta-val">Dify · RAGFlow · Python · Prompt</span>
        </div>
        <div class="sdkai-hero-meta-item">
          <span class="sdkai-hero-meta-key">我的角色</span>
          <span class="sdkai-hero-meta-val">工作流迭代 · 知识库治理 · 文档关联处理 · 问答测试与优化</span>
        </div>
      </div>
      <div class="sdkai-hero-tags">
        <span class="tag tag--accent">真实项目经历</span>
        <span class="tag">作品集交互原型</span>
        <span class="tag">不虚构业务指标</span>
      </div>
      <p class="sdkai-hero-desc">
        面向 SDK 开发者的智能技术支持系统，目标是帮助开发者自助解决 SDK 使用问题、减少重复技术咨询。
        本页重点展示方案分析与验证过程：问题拆解、知识库治理、需求分析与解决方案、问答交互原型与结果复盘。
      </p>
      <p class="sdkai-hero-entry">
        <a class="btn btn--solid" href="/work/sdk-ai-support-demo">View Demo →</a>
      </p>
    
    </div>
  </section>

  <!-- ======================= 模块导航栏（吸顶，含阅读进度线） ======================= -->
  <nav class="sdkai-hero-anchors" aria-label="目录锚点">
    <div class="container sdkai-toc-inner">
      <span class="sdkai-progress" id="sdkai-progress" role="progressbar" aria-label="阅读进度"></span>
      <a href="#background">01 项目背景与目标</a>
      <a href="#role">02 我的角色与核心工作</a>
      <a href="#solution">03 需求分析与解决方案</a>
      <a href="#demo">04 问答交互原型</a>
      <a href="#review">05 项目结果与复盘</a>
    </div>
  </nav>

  <!-- ======================= 01 项目背景与目标 ======================= -->
  <section id="background" class="sdkai-section">
    <div class="container">
      <div class="sdkai-section-head">
        <span class="sdkai-section-num">01</span>
        <h2>项目背景与目标</h2>
      </div>
      <p class="sdkai-p sdkai-p--lead">
        项目面向<strong>SDK 开发者与技术支持团队</strong>：开发者接入 SDK 时常遇到接入、配置与排查问题，
        支持人员反复回答类似问题。目标是打造一个<strong>基于 RAG 的智能问答系统</strong>，
        让开发者自助解决高频问题、减少重复技术咨询。以下问题拆解来自真实项目背景，
        用「问题 → 需求」的结构解释为什么需要版本路由、平台判断、知识库隔离与文档关联。
      </p>

      <div class="sdkai-problem-grid">
        {
          problems.map((p, i) => (
            <article class="sdkai-problem">
              <span class="sdkai-problem-num">{String(i + 1).padStart(2, '0')}</span>
              <h4>{p.issue}</h4>
              <p class="sdkai-problem-need"><strong>对应需求：</strong>{p.need}</p>
              <span class="sdkai-problem-tag sdkai-problem-tag--real">{p.tag}</span>
            </article>
          ))
        }
      </div>

      <p class="sdkai-note sdkai-note--dim">
        <strong>项目真实状态：</strong>内部 POC，处于内部测试阶段，未对外正式上线，没有可公开的真实线上业务指标。
      </p>
    </div>
  </section>

  <!-- ======================= 02 我的角色与核心工作 ======================= -->
  <section id="role" class="sdkai-section sdkai-section--alt">
    <div class="container">
      <div class="sdkai-section-head">
        <span class="sdkai-section-num">02</span>
        <h2>我的角色与核心工作</h2>
      </div>
      <p class="sdkai-p sdkai-p--lead">
        一句话结论：在团队共同推进的项目中，我的核心贡献是<strong>让「知识」与「边界」更可控</strong>——
        通过 FAQ 清洗治理、知识图谱关联、平台分流与测试用例驱动评测，把问答质量从「靠感觉」变为「可验证」。
      </p>
      <p class="sdkai-p">
        <span class="tag tag--accent">真实项目记录</span>
        以下为我在原项目中的实际参与内容：
      </p>
      <ul class="sdkai-list">
        <li>参与 SDK 版本与开发平台的<strong>分流优化</strong>，减少版本 / 平台上下文混淆。</li>
        <li>参与 600+ 条历史 FAQ 的<strong>清洗与治理</strong>，整理为 100+ 条可用于知识库的问答。</li>
        <li>使用 Python 构建 SDK 文档之间的<strong>关联知识图谱</strong>，处理文档引用关系不易被普通检索发现的问题。</li>
        <li>基于历史 FAQ 设计具体问题、模糊问题等<strong>测试用例</strong>，参与<strong>问题分析、Prompt 优化与回归测试</strong>。</li>
      </ul>
      <p class="sdkai-note sdkai-note--dim">
        <strong>团队与个人分工：</strong>上述为参与性贡献。系统整体架构、Dify 工作流与 RAGFlow 知识库主体由团队共同推进，
        并非我独立主导系统架构或独立设计全部原始 Prompt；本页的交互原型与方案总结为作品集整理补充。
      </p>
    </div>
  </section>

  <!-- ======================= 03 需求分析与解决方案 ======================= -->
  <section id="solution" class="sdkai-section">
    <div class="container">
      <div class="sdkai-section-head">
        <span class="sdkai-section-num">03</span>
        <h2>需求分析与解决方案</h2>
      </div>
      <figure
        style="margin:0 0 20px;padding:12px;border:1px solid #e5e7eb;border-radius:12px;background:#fff;"
      >
        <img
          src="/images/智能客服架构图.png"
          alt="基于 SDK 版本的三分支分流架构"
          loading="lazy"
          style="display:block;width:100%;height:auto;border-radius:8px;"
        />
        <figcaption
          style="margin-top:10px;font-size:14px;line-height:1.7;color:#6b7280;text-align:center;"
        >
          基于 SDK 版本的分流架构，通过独立知识库隔离 + Prompt 边界约束，
          从机制上解决跨版本、跨平台的知识混淆问题。
        </figcaption>
      </figure>
      <p class="sdkai-p sdkai-p--lead">
        <strong>核心问题：</strong>问答质量取决于「检索到什么」和「如何约束回答」。
        方案分三层：<strong>治理知识</strong>（FAQ 清洗、文档关联）→
        <strong>限定检索边界</strong>（按 SDK 版本路由、按平台过滤）→
        <strong>约束回答</strong>（Prompt 限定版本与平台范围、不编造结论），并用测试驱动迭代。
      </p>
      <p class="sdkai-p">
        <strong>关键处理分支：</strong>未选择版本先追问；未指定平台先追问；
        检索到疑似跨平台内容时先澄清平台；资料不足时明确说明、不编造技术结论。
        平台冲突澄清、资料不足处理来自真实工作流思路；版本 / 平台缺失追问为作品集补全的设计建议。
      </p>

      <h3 class="sdkai-h3">FAQ 清洗与整理（真实背景）</h3>
      <div class="sdkai-gov-flow" aria-label="FAQ 清洗流程">
        <div class="sdkai-gov-step">
          <span class="sdkai-gov-num">600+ 条</span>
          <span class="sdkai-gov-label">历史 FAQ 原始条目</span>
        </div>
        <span class="sdkai-gov-arrow">→</span>
        <div class="sdkai-gov-step">
          <span class="sdkai-gov-num">清洗 · 去重 · 归一化</span>
          <span class="sdkai-gov-label">筛掉重复与低质量条目</span>
        </div>
        <span class="sdkai-gov-arrow">→</span>
        <div class="sdkai-gov-step">
          <span class="sdkai-gov-num">100+ 条</span>
          <span class="sdkai-gov-label">可直接用于知识库的高质量问答</span>
        </div>
      </div>
      <p class="sdkai-p">
        原项目实习中，我参与了历史 FAQ 的清洗与治理：将 600+ 条历史问答经过去重、归一化与质量筛选，
        整理为 100+ 条可用于知识库的 FAQ。清洗目的是减少重复与低质量条目，提升知识可用性。
      </p>
      <p class="sdkai-note sdkai-note--dim">
        清洗规则为项目团队实践的一部分，此处为<strong>作品集方法总结</strong>，不代表每条规则均由我独立制定；
        未编造清洗后的准确率或效果提升数据。
      </p>

      <h3 class="sdkai-h3">文档关联知识图谱（概念示意图）</h3>
      <p class="sdkai-p">
        文档之间存在超链接引用关系：例如「接入说明」会链到「初始化配置」与相关 FAQ。
        这类引用关系在普通检索里不易被发现——只命中单一文档时，配套资料仍是割裂的。
        我使用 Python 脚本解析文档中的链接关系，构建文档之间的关联边，帮助处理「文档互相引用导致相关内容不易被发现」的问题，
        让相关知识可以顺着引用被发现。
      </p>

      <div class="sdkai-graph" aria-label="文档关联知识图谱概念图">
        <svg viewBox="0 0 720 300" role="img" aria-label="文档与 FAQ 节点通过超链接关系相连，跨平台关联需过滤">
          <!-- 连线 -->
          <line x1="222" y1="86" x2="330" y2="54" class="sdkai-graph-edge" />
          <line x1="226" y1="106" x2="500" y2="142" class="sdkai-graph-edge" />
          <line x1="506" y1="90" x2="506" y2="132" class="sdkai-graph-edge" />
          <line x1="142" y1="112" x2="142" y2="188" class="sdkai-graph-edge sdkai-graph-edge--cross" />
          <line x1="241" y1="222" x2="400" y2="232" class="sdkai-graph-edge" />

          <!-- 文档节点 -->
          <g class="sdkai-graph-node">
            <rect x="28" y="60" width="198" height="52" rx="8" />
            <text x="127" y="82" class="sdkai-graph-title">TopOn · Flutter 开屏广告接入说明</text>
            <text x="127" y="99" class="sdkai-graph-meta">SDK 文档 · TopOn · Flutter</text>
          </g>
          <g class="sdkai-graph-node">
            <rect x="330" y="28" width="190" height="52" rx="8" />
            <text x="425" y="50" class="sdkai-graph-title">TopOn · Flutter 初始化配置说明</text>
            <text x="425" y="67" class="sdkai-graph-meta">SDK 文档 · TopOn · Flutter</text>
          </g>
          <g class="sdkai-graph-node sdkai-graph-node--faq">
            <rect x="410" y="132" width="200" height="52" rx="8" />
            <text x="510" y="154" class="sdkai-graph-title">FAQ：Flutter 初始化失败排查</text>
            <text x="510" y="171" class="sdkai-graph-meta">FAQ · TopOn · Flutter</text>
          </g>
          <g class="sdkai-graph-node">
            <rect x="43" y="188" width="198" height="52" rx="8" />
            <text x="142" y="210" class="sdkai-graph-title">TopOn · Android 开屏广告接入说明</text>
            <text x="142" y="227" class="sdkai-graph-meta">SDK 文档 · TopOn · Android</text>
          </g>
          <g class="sdkai-graph-node sdkai-graph-node--faq">
            <rect x="400" y="212" width="212" height="52" rx="8" />
            <text x="506" y="234" class="sdkai-graph-title">FAQ：如何确认文档适用平台</text>
            <text x="506" y="251" class="sdkai-graph-meta">FAQ · 通用</text>
          </g>

          <!-- 关系标注 -->
          <g class="sdkai-graph-label">
            <rect x="250" y="60" width="68" height="18" rx="9" />
            <text x="284" y="73">互相引用</text>
          </g>
          <g class="sdkai-graph-label sdkai-graph-label--warn">
            <rect x="70" y="140" width="128" height="18" rx="9" />
            <text x="134" y="153">跨平台 · 需过滤</text>
          </g>
        </svg>
        <div class="sdkai-graph-legend">
          <span><i class="sdkai-graph-swatch sdkai-graph-swatch--doc"></i>SDK 文档节点</span>
          <span><i class="sdkai-graph-swatch sdkai-graph-swatch--faq"></i>FAQ 节点</span>
          <span><i class="sdkai-graph-swatch sdkai-graph-swatch--link"></i>超链接 / 引用关系</span>
          <span><i class="sdkai-graph-swatch sdkai-graph-swatch--cross"></i>跨平台关联（需平台过滤）</span>
        </div>
      </div>
      <p class="sdkai-note sdkai-note--dim">
        上图为<strong>概念化示意图</strong>，用于解释文档关联知识图谱的思路，并非真实系统截图或真实知识库数据。
        图谱为知识检索补充「顺着引用找配套资料」的线索，不能替代关键词检索。
      </p>

      <h3 class="sdkai-h3">知识库隔离与检索范围</h3>
      <p class="sdkai-p">
        不同 SDK 版本使用独立知识库；同一知识库内可能同时存在 Android、iOS、Unity 等平台的文档与 FAQ。
        因此检索需要「先按版本路由到对应知识库，再按平台过滤文档」，下方浏览器用于演示这一机制。
        以下全部为<strong>演示资料</strong>，用于解释检索逻辑，不代表官方 SDK 文档。
      </p>
      <div class="sdkai-kb-filters" aria-label="知识库筛选">
        <label class="sdkai-field">
          <span>SDK 版本筛选</span>
          <select id="sdk-kb-version">
            <option value="">全部</option>
            {
              SDK_VERSIONS.map((v) => <option value={v}>{v}</option>)
            }
          </select>
        </label>
        <label class="sdkai-field">
          <span>开发平台筛选</span>
          <select id="sdk-kb-platform">
            <option value="">全部</option>
            {
              PLATFORMS.map((p) => <option value={p}>{p}</option>)
            }
          </select>
        </label>
        <label class="sdkai-field">
          <span>文档类型筛选</span>
          <select id="sdk-kb-type">
            <option value="">全部</option>
            {
              DOC_TYPES.map((t) => <option value={t}>{t}</option>)
            }
          </select>
        </label>
        <label class="sdkai-field sdkai-field--search">
          <span>搜索文档</span>
          <input id="sdk-kb-search" type="search" placeholder="输入标题或内容关键词" aria-label="搜索文档" />
        </label>
      </div>

      <p class="sdkai-kb-count" id="sdk-kb-count"></p>
      <div class="sdkai-kb-list" id="sdk-kb-list" aria-live="polite"></div>

      <h3 class="sdkai-h3">Prompt 关键设计</h3>
      <p class="sdkai-p">
        回答质量不只取决于检索，还取决于 Prompt 如何约束回答范围与事实边界。
        以下为作品集整理后的<strong>关键片段</strong>，并非原项目历史原始 Prompt 全文。
      </p>
      <pre class="sdkai-prompt">{promptSnippet}</pre>
      <ul class="sdkai-list">
        {
          promptIntents.filter((_, i) => [0, 1, 3, 5].includes(i)).map((it) => (
            <li><strong>{it.rule}</strong>：{it.risk}</li>
          ))
        }
      </ul>
      <p class="sdkai-note sdkai-note--dim">
        仅保留能体现方案思考的关键约束，每条约束对应一类具体风险，避免「答案看起来合理、实际不可用」。
      </p>
    </div>
  </section>

  <!-- ======================= 04 交互体验 ======================= -->
  <section id="demo" class="sdkai-section sdkai-section--alt">
    <div class="container">
      <div class="sdkai-section-head">
        <span class="sdkai-section-num">04</span>
        <h2>交互体验：SDK 智能问答台</h2>
      </div>
      <p class="sdkai-p sdkai-p--lead">
        本节用可操作的原型展示核心应用能力：<strong>选择 SDK 版本与开发平台 → 输入问题 → 路由到对应知识边界 → 输出回答与资料依据</strong>，

---
import CaseStudyLayout, { type CaseSection } from '../../layouts/CaseStudyLayout.astro';

const sections: CaseSection[] = [
  {
    id: 'overview',
    num: '01',
    title: '项目概览',
    blocks: [
      {
        type: 'info',
        rows: [
          ['项目类型', 'SDK 开发者工具 · 包体检测自动化'],
          ['项目状态', '已在小组内使用'],
          ['我的角色', '独立开发 Python 检测工具、接入 Hermes 与钉钉'],
          ['技术方向', 'Python · Hermes · Android APK · 钉钉通知'],
        ],
      },
      {
        type: 'p',
        text: '这是一个面向 SDK 接入场景的包体增量检测工具：构建空包基线 APK 与引入 SDK 后的 APK，计算两者的体积差，输出检测结果；并通过 Hermes 提供自然语言检测入口，把结果同步到钉钉。',
      },
      {
        type: 'p',
        text: '工具解决的是「包体变化是否可接受」这一具体问题。相比人工多次构建、手工记录和口头同步，它把构建、对比和结果通知串成一条可重复的流程。',
      },
      {
        type: 'note',
        bold: '真实性标注',
        text: '本页「真实项目记录」部分来自我实际开发与接入的工作：Python 检测脚本、Hermes 参数提取与调用、钉钉通知链路、小组内使用。页面不展示真实构建日志、内部配置或具体包体数值。',
      },
      {
        type: 'tags',
        accent: true,
        items: ['真实项目记录', 'AI 工具落地', '小组内使用'],
      },
    ],
  },
  {
    id: 'users',
    num: '02',
    title: '目标用户与问题',
    blocks: [
      {
        type: 'p',
        text: '目标用户是负责 SDK 接入、版本发布与回归验证的开发者和测试人员，以及需要了解包体变化结果的项目成员。',
      },
      { type: 'h', text: '用户面对的问题' },
      {
        type: 'list',
        items: [
          '确认 SDK 带来的包体变化，需要分别构建基线包和接入后的包，再手工对比。',
          '构建结果分散在本地目录，体积数据靠手工记录，容易遗漏或混淆版本。',
          '检测结果需要再次通过聊天工具同步给其他成员，信息传递链路长。',
          '不熟悉脚本参数的成员难以直接使用检测能力，工具容易被少数人掌握。',
        ],
      },
      { type: 'h', text: '产品切入点' },
      {
        type: 'p',
        text: '把确定性的构建与计算交给 Python 脚本，把「怎么描述检测需求」交给自然语言入口，把「结果给谁看」交给钉钉通知。三层各做自己擅长的事，降低工具的使用门槛。',
      },
    ],
  },
  {
    id: 'solution',
    num: '03',
    title: '产品方案与工作流',
    blocks: [
      {
        type: 'flow',
        lines: [
          '自然语言描述检测需求',
          '↓',
          'Hermes 提取检测参数',
          '↓',
          '调用本地 Python 检测脚本',
          '↓',
          '构建空包基线 APK',
          '↓',
          '构建引入 SDK 后的 APK',
          '↓',
          '计算体积差并输出结果',
          '↓',
          '钉钉通知',
        ],
      },
      { type: 'h', text: '各层职责' },
      {
        type: 'list',
        items: [
          'Python 脚本：执行构建、读取 APK、计算体积差，保证结果可重复。',
          'Hermes：理解自然语言描述，提取检测所需参数，调用本地脚本。',
          '钉钉：把检测结果推送到协作场景，减少人工转述。',
        ],
      },
      {
        type: 'p',
        text: '脚本保持可独立运行，Hermes 只负责入口与参数传递。这样即使对话入口不可用，检测能力本身仍然可以使用，也便于单独排查是参数问题还是脚本问题。',
      },
      {
        type: 'note',
        bold: '说明',
        text: '以上为真实工具链路的概括说明。本页不提供真实工程路径、构建产物、包体数值或钉钉配置。',
      },
    ],
  },
  {
    id: 'decisions',
    num: '04',
    title: '关键设计决策',
    blocks: [
      {
        type: 'decisions',
        itemsDecisions: [
          {
            label: '决策 01',
            title: '用空包基线做对照',
            text: '先构建空包作为基线，再构建引入 SDK 后的 APK。以两者差值作为判断依据，减少业务代码差异对结果的干扰。',
          },
          {
            label: '决策 02',
            title: '检测逻辑与对话入口分离',
            text: '核心构建与计算留在 Python 脚本中，Hermes 只做自然语言参数提取和调用。避免把确定性逻辑耦合进对话层，降低维护成本。',
          },
          {
            label: '决策 03',
            title: '结果进入协作流',
            text: '检测完成后通过钉钉通知，让结果不滞留在个人终端，也方便其他成员直接看到结论。',
          },
          {
            label: '决策 04',
            title: '优先降低使用门槛',
            text: '用自然语言描述替代记忆脚本参数，让不熟悉命令行的成员也能发起检测；同时保留脚本的独立运行方式，兼顾灵活性。',
          },
        ],
      },
    ],
  },
  {
    id: 'contribution',
    num: '05',
    title: '真实贡献与验证证据',
    blocks: [
      { type: 'h', text: '我实际完成的工作' },
      {
        type: 'list',
        items: [
          '使用 Python 独立开发 Android APK 包体增量检测工具。',
          '构建空包基线和引入 SDK 后的 APK，计算两者体积差。',
          '将检测脚本接入 Hermes，支持用自然语言描述检测需求，由 Hermes 提取参数并调用本地脚本。',
          '打通 Hermes 与钉钉通知链路，使检测结果可以通过钉钉反馈。',
          '工具已在小组内实际使用。',
        ],
      },
      { type: 'h', text: '验证方式' },
      {
        type: 'p',
        text: '以真实 Android 工程构建空包与接入 SDK 的 APK，对比体积差并核对结果；接入 Hermes 后，用自然语言描述检测需求，确认参数提取与脚本调用能够完成一次完整检测；最后验证钉钉端能收到结果。',
      },
      {
        type: 'note',
        bold: '不展示的内容',
        text: '本页不提供具体包体数值、真实构建日志、内部路径或钉钉配置，避免将演示说明包装成可复现的生产记录。',
      },
    ],
  },
  {
    id: 'limitations',
    num: '06',
    title: '项目局限与后续优化',
    blocks: [
      { type: 'h', text: '当前局限' },
      {
        type: 'list',
        items: [
          '当前面向 Android APK，尚未覆盖 iOS 等其他产物。',
          '检测依赖本地构建环境，环境差异可能影响构建与对比结果。',
          '自然语言参数提取的效果依赖需求描述的清晰程度。',
          '钉钉通知依赖已有的机器人与群配置，换环境需要重新接入。',
        ],
      },
      { type: 'h', text: '优化设想' },
      {
        type: 'p',
        text: '以下为尚未在原项目中实现的改进方向，仅作为产品思考展示：',
      },
      {
        type: 'list',
        items: [
          '支持 iOS 与多产物对比，统一不同平台的包体检测口径。',
          '将体积变化按模块或依赖归因，而不只给出总体差值。',
          '记录历史检测结果，支持版本之间的趋势对比。',
          '接入 CI 流程，在构建阶段自动执行检测并通知结果。',
        ],
      },
      {
        type: 'tags',
        items: ['优化设想', '未在原项目实现'],
      },
    ],
  },
];
---

<CaseStudyLayout
  caseNo="03"
  title="SDK 包体增量检测工具"
  subtitle="基于 Hermes 的自然语言检测入口：从描述需求、提取参数、调用 Python 脚本，到钉钉结果通知。"
  description="SDK 包体增量检测工具 Case Study：Python 自动化、Hermes 自然语言参数提取、APK 体积差计算与钉钉通知。"
  tags={['AI 工具落地', 'Python', 'Hermes', 'Android APK']}
  current="work"
  sections={sections}
  neighbors={{
    prev: { href: '/work/mcp-sdk-agent', label: '项目 B · MCP SDK 自动化集成助手' },
    next: { href: '/work/sdk-ai-support', label: '项目 A · SDK 开发者智能问答与知识库系统' },
  }}
/>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const strengths = [
  {
    num: '01',
    title: '懂技术',
    desc: '理解 SDK 编译与工程逻辑，能写 Python 工具，和研发沟通无门槛，方案不脱节。',
    evidence: '对应项目：基于 Hermes 的 SDK 包体增量检测工具',
    href: '/work/sdk-size-checker',
  },
  {
    num: '02',
    title: '会设计',
    desc: '能把业务问题拆成 Agent 工作流，懂 RAG、Prompt、多版本分流的完整设计逻辑。',
    evidence: '对应项目：SDK开发者AI智能客服与知识库系统',
    href: '/work/sdk-ai-support',
  },
  {
    num: '03',
    title: '重落地',
    desc: '用测试用例验证效果，用数据驱动迭代，拒绝凭感觉做 AI 产品。',
    evidence: '对应项目：FAQ 治理与评测迭代',
    href: '/work/sdk-ai-support#solution',
  },
];

interface Project {
  type: string;
  status: string;
  title: string;
  problem: string;
  work: string[];
  result: string;
  tags: string[];
  href: string;
  demoHref?: string;
  demoLabel?: string;
}

const projects: Project[] = [
  {
    type: 'AI 知识问答 · RAG',
    status: '已内部验证',
    title: 'SDK 开发者智能问答与知识库系统',
    problem: '面向 SDK 开发者技术支持场景，针对多版本文档分散、跨版本回答易混淆的痛点，搭建智能问答体系。',
    work: [
      '主导 600+ 条 FAQ 清洗治理，设计版本分流与知识库隔离架构',
      '搭建多维度测试集，建立 Prompt 优化与回归验证闭环',
    ],
    result: '完成内部全流程验证，可覆盖多数开发者常见问题。',
    tags: ['RAG', '知识库治理', '多版本分流'],
    href: '/work/sdk-ai-support',
    demoHref: '/work/sdk-ai-support-demo',
    demoLabel: 'View Demo',
  },
  {
    type: 'Agent 自动化集成 · MCP',
    status: '内部 POC',
    title: '基于 MCP 的 SDK 自动化集成助手',
    problem: '针对 SDK 接入涉及依赖配置、初始化、代码注入与编译验证多手动步骤的痛点，设计自动化接入方案。',
    work: [
      '梳理 IDE Agent、MCP Server 与本地 CLI 的协作流程，负责 Agent Prompt 设计与测试',
      '在 Android Demo 中验证代码注入、配置错误与编译问题并持续迭代',
    ],
    result: '完成核心流程 POC 验证，可自动识别代码注入与配置异常（详见完整案例）。',
    tags: ['MCP', 'Agent', 'Prompt 设计', 'Android Demo'],
    href: '/work/mcp-sdk-agent',
    demoHref: '/work/mcp-sdk-agent-demo',
    demoLabel: 'View Demo',
  },
  {
    type: 'AI 工具落地 · Hermes',
    status: '小组内使用',
    title: '基于 Hermes 的 SDK 包体增量检测工具',
    problem: '针对 SDK 包体增量检测依赖人工操作、标准不统一的痛点，实现自动化检测工具。',
    work: [
      '使用 Python 编写 APK 包体增量检测脚本',
      '接入 Hermes 提取自然语言参数并调用本地脚本，打通钉钉通知链路',
    ],
    result: '工具已在小组内实际使用（详见完整案例）。',
    tags: ['Python', 'Hermes', 'APK 体积差', '钉钉通知'],
    href: '/work/sdk-size-checker',
    demoHref: '/work/sdk-size-demo',
    demoLabel: 'View Demo',
  },
];

const methodSteps = [
  '理解用户问题',
  '拆解产品需求',
  '设计 AI 工作流',
  '测试与迭代',
  '验证实际效果',
];

const methodCapabilities = [
  {
    title: '需求拆解与场景分析',
    desc: '从真实咨询与文档使用场景出发，区分具体问题、模糊问题与跨平台问题，先明确边界再设计。',
  },
  {
    title: 'RAG、Prompt 与 Agent 工作流设计',
    desc: '围绕 SDK 版本、开发平台与知识边界，设计路由、澄清、检索与回答约束。',
  },
  {
    title: '测试集设计、问题分析与回归验证',
    desc: '用历史 FAQ 构造测试用例，定位失败原因，修改 Prompt 或规则后做回归验证。',
  },
  {
    title: '与研发协作及自动化工具实践',
    desc: '用 Python 编写检测脚本，理解 SDK 编译与配置约束，能和研发对齐实现细节。',
  },
];

const methodAbilities = [
  {
    num: '01',
    title: '问题定义',
    core: '先理解用户遇到的真实问题，再确定需要解决的目标。',
    desc: '围绕用户场景、现有流程与问题表现，分析需要改善的环节——信息不足时先澄清 SDK 版本与开发平台，让模型在正确的边界内回答，避免为了使用 AI 而使用 AI。',
    practice: [
      { label: 'SDK 智能问答与知识库系统', href: '/work/sdk-ai-support' },
    ],
  },
  {
    num: '02',
    title: '方案设计',
    core: '结合任务特点，设计合适的 AI 工作流与工具协作方式。',
    desc: '理解 RAG、Prompt、Agent 与工具调用在应用中的作用，关注工作流、输入输出、用户确认与执行边界；先路由、再检索，用版本 / 平台分流划定知识边界。',
    practice: [
      { label: 'Dify / RAGFlow 智能问答工作流', href: '/work/sdk-ai-support' },
      { label: 'MCP SDK 自动化集成助手', href: '/work/mcp-sdk-agent' },
      { label: 'Hermes 包体增量检测工具', href: '/work/sdk-size-checker' },
    ],
  },
  {
    num: '03',
    title: '测试与迭代',
    core: '把问题转化为可验证的测试案例，通过失败分析推动持续改进。',
    desc: '围绕具体问题、模糊问题与异常场景设计测试用例，分析失败原因，迭代 Prompt 或工作流，并用回归验证代替「感觉好用」。',
    practice: [
      { label: 'SDK 智能问答：测试问题集与 Prompt 迭代', href: '/work/sdk-ai-support' },
      { label: 'MCP 集成助手：Prompt 测试与 Android Demo 验证', href: '/work/mcp-sdk-agent' },
    ],
  },
  {
    num: '04',
    title: '工程落地',
    core: '关注方案是否真正可执行，并通过工程实践验证结果。',
    desc: '理解 API、SDK、脚本与构建流程，能与研发协作，把产品方案转化为可运行、可验证的实际流程。用 Python 对比基线 APK 与引入 SDK 后的体积差，接入 Hermes 提取参数并打通钉钉通知。',
    practice: [
      { label: 'Hermes 包体增量检测工具（已在小组内使用）', href: '/work/sdk-size-checker' },
    ],
  },
];
---

<BaseLayout
  title="陈卓杰 · AI 应用产品经理作品集"
  description="AI 应用产品经理校招作品集：RAG 知识库、Agent 工作流、MCP 集成与 Python 自动化实践"
  current="home"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="kicker">陈卓杰 · 2027 届</p>
      <h1 class="hero-title">
        从 AI 能力，<br />到<span class="accent-line">可验证</span>的产品方案。
      </h1>
      <p class="hero-role">AI 应用产品经理｜聚焦 RAG、Agent 与开发者工具落地</p>
      <p class="hero-sub">
        关注 AI 应用的真实落地：从用户问题、工作流设计，到工具集成、测试验证与持续迭代。
      </p>
      <div class="hero-meta">
        <span class="tag">RAG 与知识库治理</span>
        <span class="tag">Agent 工作流与工具调用</span>
        <span class="tag">Python 自动化与工程验证</span>
      </div>
      <div class="hero-actions">
        <a class="btn btn--solid" href="#projects">查看项目案例</a>
        <a class="btn btn--outline" href="#about">我的方法与实践</a>
      </div>
    </div>
  </section>

  <!-- 核心优势 -->
  <section class="section" id="strengths">
    <div class="container">
      <p class="kicker">WHY ME</p>
      <h2 class="h-lg">为什么选我？</h2>
      <div class="strengths">
        {
          strengths.map((s) => (
            <article class="strength">
              <span class="strength-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <a class="strength-link" href={s.href}>{s.evidence} →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="section section--tight" id="projects">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">Selected Work</p>
          <h2 class="h-lg">项目经历</h2>
        </div>
      </div>
      <p class="section-lead">
        三个项目属于同一类 SDK 开发者业务场景，分别对应 AI 知识问答、Agent 自动化集成与 AI 工具落地。
        每张卡片完整呈现问题、个人工作与成果证据，深度细节可进入完整案例。
      </p>
      <div class="project-list">
        {
          projects.map((p) => (
            <article class="project-card">
              <div class="project-top">
                <span class="project-type">{p.type}</span>
                <span class="project-status">{p.status}</span>
              </div>
              <a class="project-title" href={p.href}>{p.title}</a>
              <p class="project-problem">{p.problem}</p>
              <ul class="project-bullets">
                {p.work.map((w) => <li>{w}</li>)}
              </ul>
              <p class="project-result"><strong>成果</strong>：{p.result}</p>
              <div class="project-bottom">
                <div class="project-tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
                <div class="project-actions">
                  <a class="project-cta project-cta--accent" href={p.href}>查看完整案例 →</a>
                  {p.demoHref && (
                    <a class="project-cta" href={p.demoHref}>{p.demoLabel} →</a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 我的工作方式 -->
  <section class="section section--tight" id="method">
    <div class="container">
      <p class="kicker">How I Work</p>
      <h2 class="h-lg">我的工作方式</h2>
      <p class="section-lead">
        从用户问题出发，把模糊需求拆成可设计、可测试、可验证的 AI 工作流。
      </p>
      <ol class="method-flow">
        {
          methodSteps.map((step, i) => (
            <li>
              <span class="method-step-num">{String(i + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))
        }
      </ol>
      <p class="method-note">
        以上是对个人工作方式的概括，并非每个项目都完整执行了全部环节。
      </p>
      <div class="method-grid">
        {
          methodCapabilities.map((c) => (
            <div class="method-item">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 我的产品方法与实践（原「关于我 / 为什么 / 能力模型 / 工作原则 / 一句话定位」合并） -->
  <section class="section section--tight" id="about" style="border-top: 1px solid var(--line);">
    <div class="container">
      <p class="kicker">About · Method</p>
      <h2 class="h-lg" style="margin: 8px 0 12px;">我的产品方法与实践</h2>
      <p class="lead" style="max-width: 680px;">
        从真实问题出发，将 AI 能力转化为可设计、可验证、可迭代的产品方案。
      </p>
      <p class="about-idea">
        不止于让 AI 能运行，更关注它能否稳定地解决实际问题。
      </p>
      <div class="hero-meta" style="margin-top: 18px;">
        <span class="tag tag--accent">目标岗位</span>
        <span class="tag">AI Application PM</span>
        <span class="tag">AI Agent PM</span>
        <span class="tag">AI Product Intern</span>
      </div>

      <div class="about-abilities" style="margin-top: 32px;">
        {
          methodAbilities.map((a) => (
            <div class="about-ability">
              <span class="about-ability-num">{a.num}</span>
              <h3 class="about-ability-title">{a.title}</h3>
              <div class="about-ability-body">
                <p class="about-ability-core">{a.core}</p>
                <p class="about-ability-desc">{a.desc}</p>
                {
                  a.practice && a.practice.length > 0 && (
                    <p class="about-ability-practice">
                      实践关联：
                      {a.practice.map((p, i) => (
                        <>
                          {i > 0 && <span class="about-practice-sep"> · </span>}
                          <a class="about-practice-link" href={p.href}>{p.label} →</a>
                        </>
                      ))}
                    </p>
                  )
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 联系 -->
  <section class="section contact-section" id="contact">
    <div class="container contact-inner">
      <p class="kicker">Contact</p>
      <h2 class="h-lg" style="margin-bottom: 16px;">期待与你交流</h2>
      <p class="lead">
        如果你在找一位懂技术、能把 AI 方案亲手验证落地的产品经理，欢迎联系我——
        无论是岗位机会，还是对 Agent / RAG 落地实践的探讨。
      </p>
      <div class="contact-actions">
        <a class="btn btn--solid" href="mailto:2499202708@qq.com">邮箱 · 2499202708@qq.com</a>
        <a class="btn btn--outline" href="tel:13380753367">电话 · 13380753367（微信同号）</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero 局部补充 ---------- */
  .hero-role {
    font-size: 15px;
    color: var(--text-3);
    letter-spacing: 0.01em;
    margin: 0 0 18px;
  }

  /* ---------- 核心优势 ---------- */
  .strengths {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .strength {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .strength-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .strength h3 {
    font-size: 17px;
    margin: 6px 0 10px;
  }

  .strength p {
    font-size: 14.5px;
    color: var(--text-3);
  }

  .strength-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 500;
  }

  /* ---------- 区块说明 ---------- */
  .section-lead {
    max-width: 720px;
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text-3);
  }

  /* ---------- 精选项目 ---------- */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .section-head .h-lg {
    margin-bottom: 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(37, 99, 235, 0.08);
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .project-type {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .project-status {
    flex: 0 0 auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 3px 12px;
    white-space: nowrap;
  }

  .project-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    transition: color 0.2s;
  }

  .project-title:hover {
    color: var(--accent);
  }

  .project-problem {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.7;
    margin: 0;
  }

  .project-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
  }

  .project-bullets li {
    position: relative;
    padding-left: 14px;
    font-size: 13.5px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .project-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .project-result {
    font-size: 13.5px;
    color: var(--text-2);
    line-height: 1.7;
    margin: 0;
  }

  .project-result strong {
    font-weight: 700;
    color: var(--accent);
  }

  .project-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .project-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    background: #fff;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .project-card:hover .project-cta {
    border-color: var(--accent);
  }

  .project-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .project-cta--accent {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---------- 我的工作方式 ---------- */
  .method-flow {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    margin-top: 32px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .method-flow li {
    position: relative;
    padding: 18px 20px 18px 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }

  .method-flow li + li {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }

  .method-flow li:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    font-weight: 400;
    color: var(--text-4);
  }

  .method-step-num {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .method-note {
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--text-4);
  }

  .method-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
    margin-top: 36px;
  }

  .method-item {
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .method-item h3 {
    margin-bottom: 6px;
    font-size: 15.5px;
  }

  .method-item p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-3);
  }

  /* ---------- 联系 ---------- */
  .contact-section {
    border-top: 1px solid var(--line);
  }

  /* ---------- 我的产品方法与实践 ---------- */
  .about-idea {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--accent);
  }

  .about-ability {
    display: grid;

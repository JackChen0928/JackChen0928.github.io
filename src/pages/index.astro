---
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    num: '01',
    title: '技术理解力',
    desc: '计算机科学本科，具备 Java / Python / SQL 开发基础，能够理解 AI 应用背后的工程实现与代码逻辑，并与开发团队协作。',
  },
  {
    num: '02',
    title: 'AI 应用设计',
    desc: '实践 Agent / RAG / MCP / Prompt Engineering / AI Evaluation，能够将 AI 技术能力转化为具体的产品方案。',
  },
  {
    num: '03',
    title: 'AI 应用落地',
    desc: '参与企业内部 AI 场景从需求分析、方案设计到测试验证与迭代，关注产品可用性与实际效果。',
  },
];

const works = [
  {
    index: '01',
    title: 'SDK Developer AI Support Agent',
    desc: '面向 SDK 开发者的 AI 技术支持助手 · Multi-Agent 分流 · FAQ 600+→100+ · 文档关联知识图谱',
    status: 'Internal Testing',
    href: '/case/sdk-support-agent',
  },
  {
    index: '02',
    title: 'MCP SDK Integration Agent',
    desc: '自然语言需求 → Agent 工作流 → SDK 自动集成 · Remote MCP + Local CLI + IDE Agent',
    status: '方案验证',
    href: '/case/mcp-integration-agent',
  },
  {
    index: '03',
    title: 'SDK 智能技术支持助手 · 交互原型',
    desc: '可交互 AI 客服前端原型：版本路由 · 平台冲突澄清 · 来源引用 · 自动评测',
    status: '交互原型 · 模拟工作流',
    href: '/work/sdk-ai-support',
  },
];
---

<BaseLayout title="AI 产品经理作品集 · 用技术理解力做能落地的 AI 产品" current="home">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="kicker">AI Application Product Manager</p>
      <h1 class="hero-title">
        用技术理解力，<br />做能<span class="accent-line">落地</span>的 AI 产品
      </h1>
      <p class="hero-sub">
        计算机科学本科 · TopOn AI 应用实习 · AI Agent / RAG / MCP 产品实践
      </p>
      <div class="hero-actions">
        <a class="btn btn--solid" href="/work">查看精选作品</a>
        <a class="btn btn--outline" href="/about">关于我</a>
      </div>
    </div>
  </section>

  <!-- 三大能力 -->
  <section class="section">
    <div class="container">
      <p class="kicker">Why Me</p>
      <h2 class="h-lg" style="margin-bottom: 48px;">我的优势，不是纯产品背景</h2>
      <div class="pillars">
        {
          pillars.map((p) => (
            <div class="pillar">
              <p class="kicker">{p.num}</p>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 精选 AI 作品 -->
  <section class="section section--tight" id="works">
    <div class="container">
      <p class="kicker">Selected AI Product Work</p>
      <h2 class="h-lg" style="margin-bottom: 16px;">精选作品</h2>
      <div class="work-index">
        {
          works.map((w) => (
            <a class="work-item" href={w.href}>
              <span class="work-item-index">{w.index}</span>
              <span>
                <span class="work-item-title">{w.title}</span>
                <br />
                <span class="work-item-desc">{w.desc}</span>
              </span>
              <span class="work-item-status">{w.status}</span>
              <span class="work-item-arrow">→</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top: 28px;">
        <a class="link-arrow" href="/work">查看全部精选作品与轻量项目</a>
      </p>
    </div>
  </section>
</BaseLayout>

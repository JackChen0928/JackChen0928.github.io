---
import BaseLayout from '../layouts/BaseLayout.astro';

const strengths = [
  {
    num: '01',
    title: '技术理解力',
    desc: '能读懂 SDK 编译链路、报错日志与工程约束，用 Python 写过包体检测脚本，和研发沟通不需要「翻译」。',
    evidence: '证据 · Python 自动化检测 SDK 包体大小',
    href: '/work/sdk-size-checker',
  },
  {
    num: '02',
    title: 'AI 应用设计',
    desc: '把业务问题拆成可执行的 Agent 流程：版本路由、平台冲突澄清、RAG 知识边界、Prompt 约束与评测闭环。',
    evidence: '证据 · SDK 开发者智能问答项目',
    href: '/work/sdk-ai-support',
  },
  {
    num: '03',
    title: '落地与验证',
    desc: '不满足于「感觉好用」。参与 FAQ 600+→100+ 清洗，用历史问题构造测试用例，分析失败并迭代 Prompt。',
    evidence: '证据 · FAQ 治理与评测迭代',
    href: '/work/sdk-ai-support',
  },
];

interface Project {
  index: string;
  type: string;
  title: string;
  problem: string;
  work: string[];
  outputs: string[];
  evidence: string;
  status: string;
  truth: string;
  tags: string[];
  href: string;
  demoHref?: string;
  demoLabel?: string;
}

const projects: Project[] = [
  {
    index: '01',
    type: 'AI 知识问答 · RAG',
    title: '小T｜SDK开发者AI智能客服与知识库系统',
    problem:
      'SDK 文档涉及不同平台和版本，历史 FAQ 分散，文档关联信息不易被检索利用，回答还需要减少跨平台混淆。',
    work: [
      '参与清洗 600+ 条历史 FAQ，整理为 100+ 条问答',
      '使用 Python 构建文档关联知识图谱',
      '设计具体问题、模糊问题等测试场景，迭代 Prompt 并回归测试',
    ],
    outputs: ['FAQ 整理', '文档关联知识图谱', '测试问题集'],
    evidence: '证据：FAQ 整理记录、文档关联脚本与测试问题集（详见完整案例）',
    status: '内部测试阶段',
    truth: '真实项目经历 · 另附作品集交互原型',
    tags: ['Dify', 'RAG', '知识库治理', 'Prompt 迭代'],
    href: '/work/sdk-ai-support',
  },
  {
    index: '02',
    type: 'Agent 自动化集成 · MCP',
    title: '基于 MCP 的 SDK 自动化集成助手',
    problem:
      'SDK 接入涉及依赖配置、初始化、广告功能代码注入和编译验证，存在多个手动操作步骤。',
    work: [
      '参与梳理 IDE Agent、Remote MCP Server、Local CLI 的协作流程',
      '负责 Agent Prompt 设计与测试',
      '在 Android Demo 中验证并迭代，针对代码遗漏、配置错误和编译问题优化',
    ],
    outputs: ['工作流设计', 'Prompt 测试案例', 'Android Demo 验证'],
    evidence: '证据：Prompt 测试记录与 Android Demo 验证（详见完整案例）',
    status: '内部 POC',
    truth: '真实项目经历 · 交互原型建设中',
    tags: ['MCP', 'Agent', 'Prompt 设计', 'Android Demo'],
    href: '/work/mcp-sdk-agent',
  },
  {
    index: '03',
    type: 'AI 工具落地 · Hermes',
    title: '基于 Hermes 的 SDK 包体增量检测工具',
    problem: '接入 SDK 前后需要构建 APK、比较体积并整理结果。',
    work: [
      '使用 Python 编写 APK 包体增量检测脚本',
      '将脚本接入 Hermes，由 Hermes 提取自然语言需求参数并调用本地脚本',
      '打通 Hermes 与钉钉的消息链路，通知检测任务结果',
    ],
    outputs: ['Python 检测脚本', 'Hermes 调用链路', '钉钉通知'],
    evidence: '证据：检测脚本与调用链路已在小组内实际使用',
    status: '小组内使用',
    truth: '真实项目经历 · 交互原型建设中',
    tags: ['Python', 'Hermes', 'APK 体积差', '钉钉通知'],
    href: '/work/sdk-size-checker',
  },
];

const methodSteps = [
  '理解用户问题',
  '拆解产品需求',
  '设计 AI 工作流',
  '测试与迭代',
  '验证实际效果',
];

const methodCapabilities = [
  {
    title: '需求拆解与场景分析',
    desc: '从真实咨询与文档使用场景出发，区分具体问题、模糊问题与跨平台问题，先明确边界再设计。',
  },
  {
    title: 'RAG、Prompt 与 Agent 工作流设计',
    desc: '围绕 SDK 版本、开发平台与知识边界，设计路由、澄清、检索与回答约束。',
  },
  {
    title: '测试集设计、问题分析与回归验证',
    desc: '用历史 FAQ 构造测试用例，定位失败原因，修改 Prompt 或规则后做回归验证。',
  },
  {
    title: '与研发协作及自动化工具实践',
    desc: '用 Python 编写检测脚本，理解 SDK 编译与配置约束，能和研发对齐实现细节。',
  },
];

const experienceBullets = [
  '参与 Dify 智能技术支持工作流的搭建与迭代，参与 SDK 版本与开发平台的分流优化。',
  '参与 600+ 条历史 FAQ 清洗与治理，整理为 100+ 条问答；使用 Python 构建 SDK 文档关联知识图谱。',
  '基于历史 FAQ 设计测试用例，进行问题分析、Prompt 优化与回归测试。',
  '参与 MCP SDK 自动化集成方案的 Agent Prompt 设计与测试，在 Android Demo 中验证代码注入与编译结果。',
  '使用 Python 开发 APK 包体增量检测工具，接入 Hermes 并打通钉钉通知链路。',
];

const techStack = ['Python', 'Java', 'SQL', 'Spring Boot', 'MySQL', 'Redis'];

const methodAbilities = [
  {
    num: '01',
    title: '问题定义',
    core: '先理解用户遇到的真实问题，再确定需要解决的目标。',
    desc: '围绕用户场景、现有流程与问题表现，分析需要改善的环节——信息不足时先澄清 SDK 版本与开发平台，让模型在正确的边界内回答，避免为了使用 AI 而使用 AI。',
    practice: [
      { label: 'SDK 智能问答与知识库系统', href: '/work/sdk-ai-support' },
    ],
  },
  {
    num: '02',
    title: '方案设计',
    core: '结合任务特点，设计合适的 AI 工作流与工具协作方式。',
    desc: '理解 RAG、Prompt、Agent 与工具调用在应用中的作用，关注工作流、输入输出、用户确认与执行边界；先路由、再检索，用版本 / 平台分流划定知识边界。',
    practice: [
      { label: 'Dify / RAGFlow 智能问答工作流', href: '/work/sdk-ai-support' },
      { label: 'MCP SDK 自动化集成助手', href: '/work/mcp-sdk-agent' },
      { label: 'Hermes 包体增量检测工具', href: '/work/sdk-size-checker' },
    ],
  },
  {
    num: '03',
    title: '测试与迭代',
    core: '把问题转化为可验证的测试案例，通过失败分析推动持续改进。',
    desc: '围绕具体问题、模糊问题与异常场景设计测试用例，分析失败原因，迭代 Prompt 或工作流，并用回归验证代替「感觉好用」。',
    practice: [
      { label: 'SDK 智能问答：测试问题集与 Prompt 迭代', href: '/work/sdk-ai-support' },
      { label: 'MCP 集成助手：Prompt 测试与 Android Demo 验证', href: '/work/mcp-sdk-agent' },
    ],
  },
  {
    num: '04',
    title: '工程落地',
    core: '关注方案是否真正可执行，并通过工程实践验证结果。',
    desc: '理解 API、SDK、脚本与构建流程，能与研发协作，把产品方案转化为可运行、可验证的实际流程。用 Python 对比基线 APK 与引入 SDK 后的体积差，接入 Hermes 提取参数并打通钉钉通知。',
    practice: [
      { label: 'Hermes 包体增量检测工具（已在小组内使用）', href: '/work/sdk-size-checker' },
    ],
  },
];
---

<BaseLayout
  title="陈卓杰 · AI 应用产品经理作品集"
  description="AI 应用产品经理校招作品集：RAG 知识库、Agent 工作流、MCP 集成与 Python 自动化实践"
  current="home"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="kicker">陈卓杰 · 2027 届校招</p>
      <h1 class="hero-title">
        把 AI 能力，<br />变成<span class="accent-line">可验证</span>的产品方案。
      </h1>
      <p class="hero-role">AI 应用产品经理｜RAG · Agent · MCP · Developer Tools</p>
      <p class="hero-sub">
        关注 AI 应用的真实落地：从用户问题、工作流设计，到工具集成、测试验证与持续迭代。
      </p>
      <div class="hero-meta">
        <span class="tag">RAG 与知识库治理</span>
        <span class="tag">Agent 工作流与工具调用</span>
        <span class="tag">Python 自动化与工程验证</span>
      </div>
      <div class="hero-actions">
        <a class="btn btn--solid" href="#projects">查看项目案例</a>
        <a class="btn btn--outline" href="#experience">个人经历</a>
      </div>
    </div>
  </section>

  <!-- 核心优势 -->
  <section class="section" id="strengths">
    <div class="container">
      <p class="kicker">Why Me</p>
      <h2 class="h-lg">我的优势，不是纯产品背景</h2>
      <div class="strengths">
        {
          strengths.map((s) => (
            <article class="strength">
              <span class="strength-num">{s.num}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <a class="strength-link" href={s.href}>{s.evidence} →</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="section section--tight" id="projects">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">Selected Work</p>
          <h2 class="h-lg">项目经历</h2>
        </div>
      </div>
      <p class="section-lead">
        三个项目属于同一类 SDK 开发者业务场景，分别对应 AI 知识问答、Agent 自动化集成与 AI 工具落地。
        每张卡片完整呈现问题、个人工作与成果证据，深度细节可进入完整案例。
      </p>
      <div class="project-list">
        {
          projects.map((p) => (
            <article class="project-card">
              <span class="project-index">{p.index}</span>
              <div class="project-body">
                <span class="project-type">{p.type}</span>
                <a class="project-title" href={p.href}>{p.title}</a>
                <p class="project-problem">{p.problem}</p>
                <div class="project-detail">
                  <div class="project-block">
                    <span class="project-label">我的工作</span>
                    <ul class="project-bullets">
                      {p.work.map((w) => <li>{w}</li>)}
                    </ul>
                  </div>
                  <div class="project-block">
                    <span class="project-label">成果产出与验证</span>
                    <ul class="project-bullets">
                      {p.outputs.map((o) => <li>{o}</li>)}
                    </ul>
                    <span class="project-evidence">{p.evidence}</span>
                  </div>
                </div>
                <div class="project-tags">
                  {p.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
                <span class="project-truth">{p.truth}</span>
              </div>
              <div class="project-side">
                <span class="project-status">{p.status}</span>
                <div class="project-actions">
                  <a class="project-cta project-cta--accent" href={p.href}>查看完整案例 →</a>
                  {p.demoHref && (
                    <a class="project-cta" href={p.demoHref}>{p.demoLabel} →</a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 我的工作方式 -->
  <section class="section section--tight" id="method">
    <div class="container">
      <p class="kicker">How I Work</p>
      <h2 class="h-lg">我的工作方式</h2>
      <p class="section-lead">
        从用户问题出发，把模糊需求拆成可设计、可测试、可验证的 AI 工作流。
      </p>
      <ol class="method-flow">
        {
          methodSteps.map((step, i) => (
            <li>
              <span class="method-step-num">{String(i + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))
        }
      </ol>
      <p class="method-note">
        以上是对个人工作方式的概括，并非每个项目都完整执行了全部环节。
      </p>
      <div class="method-grid">
        {
          methodCapabilities.map((c) => (
            <div class="method-item">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 实习与技术背景 -->
  <section class="section section--tight" id="experience">
    <div class="container">
      <p class="kicker">Experience &amp; Background</p>
      <h2 class="h-lg">实习与技术背景</h2>
      <div class="exp-list">
        <article class="exp-item">
          <div class="exp-meta">
            <span class="exp-date">2026.03 — 2026.08</span>
            <span class="exp-type">实习</span>
          </div>
          <div class="exp-body">
            <h3>TopOn · AI 应用实习</h3>
            <p>参与 SDK 开发者智能技术支持相关的 AI 应用实践，主要工作包括：</p>
            <ul class="exp-bullets">
              {experienceBullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </article>
        <article class="exp-item">
          <div class="exp-meta">
            <span class="exp-date">教育</span>
            <span class="exp-type">本科</span>
          </div>
          <div class="exp-body">
            <h3>计算机科学与技术 · 本科</h3>
            <p>
              计算机专业背景，保留工程实践能力，能够理解 SDK 编译链路、配置约束与研发协作方式。
            </p>
            <p class="exp-muted">学校名称与毕业时间待补充。</p>
          </div>
        </article>
      </div>
      <div class="exp-tech">
        <div class="exp-tech-row">
          <span class="exp-tech-label">技术栈</span>
          <div class="exp-tech-tags">
            {techStack.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
        <div class="exp-tech-row">
          <span class="exp-tech-label">简历</span>
          <span class="btn btn--disabled" aria-disabled="true">简历 PDF · 待补充</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 我的产品方法与实践（原「关于我 / 为什么 / 能力模型 / 工作原则 / 一句话定位」合并） -->
  <section class="section section--tight" id="about" style="border-top: 1px solid var(--line);">
    <div class="container">
      <p class="kicker">About · Method</p>
      <h2 class="h-lg" style="margin: 8px 0 12px;">我的产品方法与实践</h2>
      <p class="lead" style="max-width: 680px;">
        从真实问题出发，将 AI 能力转化为可设计、可验证、可迭代的产品方案。
      </p>
      <p class="about-idea">
        不止于让 AI 能运行，更关注它能否稳定地解决实际问题。
      </p>
      <div class="hero-meta" style="margin-top: 18px;">
        <span class="tag tag--accent">目标岗位</span>
        <span class="tag">AI Application PM</span>
        <span class="tag">AI Agent PM</span>
        <span class="tag">AI Product Intern</span>
      </div>

      <div class="about-abilities" style="margin-top: 32px;">
        {
          methodAbilities.map((a) => (
            <div class="about-ability">
              <span class="about-ability-num">{a.num}</span>
              <h3 class="about-ability-title">{a.title}</h3>
              <div class="about-ability-body">
                <p class="about-ability-core">{a.core}</p>
                <p class="about-ability-desc">{a.desc}</p>
                {
                  a.practice && a.practice.length > 0 && (
                    <p class="about-ability-practice">
                      实践关联：
                      {a.practice.map((p, i) => (
                        <>
                          {i > 0 && <span class="about-practice-sep"> · </span>}
                          <a class="about-practice-link" href={p.href}>{p.label} →</a>
                        </>
                      ))}
                    </p>
                  )
                }
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 联系 -->
  <section class="section contact-section" id="contact">
    <div class="container contact-inner">
      <p class="kicker">Contact</p>
      <h2 class="h-lg" style="margin-bottom: 16px;">期待与你交流</h2>
      <p class="lead">
        如果你在找一位懂技术、能把 AI 方案亲手验证落地的产品经理，欢迎联系我——
        无论是岗位机会，还是对 Agent / RAG 落地实践的探讨。
      </p>
      <div class="contact-actions">
        <a class="btn btn--solid" href="mailto:2499202708@qq.com">邮箱 · 2499202708@qq.com</a>
        <a class="btn btn--outline" href="tel:13380753367">电话 · 13380753367（微信同号）</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero 局部补充 ---------- */
  .hero-role {
    font-size: 15px;
    color: var(--text-3);
    letter-spacing: 0.01em;
    margin: 0 0 18px;
  }

  /* ---------- 核心优势 ---------- */
  .strengths {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .strength {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .strength-num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .strength h3 {
    font-size: 17px;
    margin: 6px 0 10px;
  }

  .strength p {
    font-size: 14.5px;
    color: var(--text-3);
  }

  .strength-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 500;
  }

  /* ---------- 区块说明 ---------- */
  .section-lead {
    max-width: 720px;
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text-3);
  }

  /* ---------- 精选项目 ---------- */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .section-head .h-lg {
    margin-bottom: 0;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 32px;
  }

  .project-card {
    display: grid;
    grid-template-columns: 56px 1fr 200px;
    gap: 24px;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(37, 99, 235, 0.08);
  }

  .project-index {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-4);
    padding-top: 2px;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .project-type {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .project-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    transition: color 0.2s;
  }

  .project-title:hover {
    color: var(--accent);
  }

  .project-problem {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .project-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 32px;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }

